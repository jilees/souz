{
  "openaiConnections": {
    "openrouter": {
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    },
    "experimental": {
      "baseUrl": "https://llm.example.com/v1",
      "apiKeyEnv": "EXPERIMENTAL_LLM_API_KEY"
    }
  },
  "models": {
    "summary": { "connection": "openrouter", "modelId": "vendor/summary-model" },
    "tv-agent": { "connection": "openrouter", "modelId": "vendor/tv-model" },
    "test-chat": { "connection": "experimental", "modelId": "my-custom-model" }
  },
  "summarization": { "model": "summary", "contextSize": 32000 },
  "subagentModels": ["tv-agent"]
}
