# Souz backend — production environment.
# Copy to /opt/souz-backend/config/backend.env on the VPS and fill in real values.
# chmod 600 it — this file holds credentials. It lives outside /opt/souz-backend/app
# so redeploys (which overwrite app/ in place) never touch it.

SOUZ_BACKEND_HOST=127.0.0.1
SOUZ_BACKEND_PORT=8080

# Agent tool execution sandbox. "local" (default) runs shell/file/skill-script
# tools directly on the host as the backend user (root on this box). "docker"
# runs them inside souz-runtime-sandbox:latest, one long-lived container per
# user, so tool execution is contained. Requires a reachable Docker daemon and
# the souz-runtime-sandbox:latest image on the host (the deploy workflow builds
# it from sharedLogic/Dockerfile).
SOUZ_SANDBOX_MODE=docker

# Host env names to forward into docker-sandbox skill commands, comma or space
# separated. LOCAL-mode skills inherit the whole backend env; docker-mode skills
# see only what is listed here. Keep it narrow — a skill that runs its own LLM
# loop (e.g. tv-control) needs the summarization key + base URL, nothing more.
SOUZ_SANDBOX_FORWARD_ENV=OPENAI_SUMMARIZATION_API_KEY,OPENAI_SUMMARIZATION_BASE_URL,OPENAI_SUMMARIZATION_MODEL

# Postgres. Create the database/role beforehand; schema + Flyway migrations
# apply automatically on every backend boot.
SOUZ_BACKEND_DB_HOST=127.0.0.1
SOUZ_BACKEND_DB_PORT=5432
SOUZ_BACKEND_DB_NAME=souz
SOUZ_BACKEND_DB_USER=souz
SOUZ_BACKEND_DB_PASSWORD=change-me
SOUZ_BACKEND_DB_SCHEMA=public

# Trust boundary: nginx must overwrite X-Souz-Proxy-Auth with this exact value
# and set X-User-Id on every proxied /v1 request. Generate with:
#   openssl rand -hex 32
SOUZ_BACKEND_PROXY_TOKEN=change-me-long-random-token

# Encrypts provider API keys and other secrets at rest. Generate once with:
#   openssl rand -base64 32
# Do not rotate without a re-encryption migration plan.
SOUZ_MASTER_KEY=change-me-32-byte-random-key

# Telegram bot bindings — optional feature, off by default.
# ENABLE_BACKEND_TG_FEATURE=true
# TELEGRAM_TOKEN_ENCRYPTION_KEY=change-me

# Salute (Sber) voice channel — optional feature, off by default. The webhook and the
# thin-client WebSocket are intentionally unauthenticated (see docs/plan risk notes);
# do not enable on a deployment where that's not an acceptable trade-off yet.
# ENABLE_BACKEND_SALUTE_FEATURE=true
